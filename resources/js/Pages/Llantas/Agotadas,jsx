import { Link, router } from '@inertiajs/react'
import AppShell from '@/Components/layout/AppShell'
import PageSection from '@/Components/ui/PageSection'
import Pagination from '@/Components/ui/Pagination'

function money(value) {
    return Number(value || 0).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
    })
}

export default function LlantasAgotadas({ llantas, filters = {} }) {
    const onSearch = (e) => {
        e.preventDefault()
        const form = new FormData(e.currentTarget)
        const search = form.get('search') || ''

        router.get('/llantas/agotadas', { search }, { preserveState: true, preserveScroll: true })
    }

    const rows = llantas?.data || []
    const total = Number(llantas?.total ?? 0)
    const searchActive = Boolean((filters.search || '').trim())
    const emptyMessage = searchActive
        ? 'No hay coincidencias con la búsqueda.'
        : 'No hay llantas agotadas en este momento.'

    return (
        <AppShell title="Llantas agotadas">
            <div className="space-y-8">
                <PageSection
                    eyebrow="Inventario"
                    title="Llantas agotadas"
                    description="Referencias con stock en cero. Busca por SKU y edita desde la tabla."
                />

                <form onSubmit={onSearch} className="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <div className="min-w-0 flex-1">
                        <label htmlFor="search-agotadas" className="mb-2 block text-sm font-semibold text-slate-900 dark:text-white">
                            Buscar
                        </label>
                        <input
                            id="search-agotadas"
                            type="text"
                            name="search"
                            defaultValue={filters.search || ''}
                            placeholder="SKU…"
                            className="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 dark:border-neutral-700 dark:bg-neutral-950 dark:text-white"
                        />
                    </div>
                    <button
                        type="submit"
                        className="rounded-2xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
                    >
                        Buscar
                    </button>
                </form>

                <div className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
                    <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-6 py-4 dark:border-neutral-800">
                        {llantas?.from != null && llantas?.to != null && total > 0 && (
                            <p className="text-sm text-slate-600 dark:text-slate-400">
                                Mostrando{' '}
                                <span className="font-semibold text-slate-900 dark:text-white">
                                    {llantas.from}–{llantas.to}
                                </span>{' '}
                                de {total.toLocaleString()}
                            </p>
                        )}
                        <span className="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-500/10 dark:text-rose-300">
                            Stock = 0
                        </span>
                    </div>
                    <div className="overflow-x-auto">
                        <table className="w-full text-sm text-slate-700 dark:text-slate-300">
                            <thead className="bg-slate-50 text-xs uppercase tracking-wide text-slate-600 dark:bg-neutral-800/80 dark:text-slate-400">
                                <tr>
                                    <th className="px-4 py-3 text-left">SKU</th>
                                    <th className="px-4 py-3">Marca</th>
                                    <th className="px-4 py-3">Medida</th>
                                    <th className="px-4 py-3 text-center">Stock</th>
                                    <th className="px-4 py-3">Descripción</th>
                                    <th className="px-4 py-3 text-right">Costo</th>
                                    <th className="px-4 py-3 text-right">Precio ML</th>
                                    <th className="px-4 py-3">Título</th>
                                    <th className="px-4 py-3">MLM</th>
                                    <th className="px-4 py-3 text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                {rows.length === 0 ? (
                                    <tr>
                                        <td colSpan={10} className="px-4 py-10 text-center text-slate-500 dark:text-slate-400">
                                            {emptyMessage}
                                        </td>
                                    </tr>
                                ) : (
                                    rows.map((llanta) => (
                                        <tr
                                            key={llanta.id}
                                            className="border-t border-slate-200 hover:bg-slate-50 dark:border-neutral-800 dark:hover:bg-neutral-800/60"
                                        >
                                            <td className="px-4 py-2 font-mono text-blue-600 dark:text-blue-400">{llanta.sku}</td>
                                            <td className="px-4 py-2">{llanta.marca || 'SIN MARCA'}</td>
                                            <td className="px-4 py-2">{llanta.medida || 'N/A'}</td>
                                            <td className="px-4 py-2 text-center font-bold text-red-600 dark:text-red-400">{llanta.stock}</td>
                                            <td className="px-4 py-2 text-slate-500 dark:text-slate-400">{llanta.descripcion}</td>
                                            <td className="px-4 py-2 text-right">${money(llanta.costo)}</td>
                                            <td className="px-4 py-2 text-right font-semibold text-emerald-600 dark:text-emerald-400">
                                                ${money(llanta.precio_ML)}
                                            </td>
                                            <td className="px-4 py-2">{llanta.title_familyname}</td>
                                            <td className="px-4 py-2 text-xs text-slate-500 dark:text-slate-400">{llanta.MLM || '-'}</td>
                                            <td className="px-4 py-2 text-center">
                                                <Link
                                                    href={`/llantas/${llanta.id}/editar`}
                                                    className="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
                                                >
                                                    Editar
                                                </Link>
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                    <div className="border-t border-slate-200 px-6 py-4 dark:border-neutral-800">
                        <Pagination className="mt-0" links={llantas?.links || []} />
                    </div>
                </div>
            </div>
        </AppShell>
    )
}
